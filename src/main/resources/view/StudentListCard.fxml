<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="detail-card" minWidth="0">
    <VBox fx:id="cardContent" HBox.hgrow="ALWAYS" alignment="TOP_LEFT" spacing="14" minWidth="0">
      <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
      </padding>
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" wrapText="true" minWidth="0"
               maxWidth="Infinity" HBox.hgrow="ALWAYS" />
      </HBox>
      <Label fx:id="matricNumber" styleClass="cell_small_label" text="\$matricNumber" />
      <Label fx:id="tutorialGroup" styleClass="cell_small_label" text="\$tutorialGroup" />
      <Label fx:id="followUp" styleClass="cell_small_label" text="\$followUp" />
      <Label fx:id="remark" styleClass="cell_small_label" text="\$remark" wrapText="true" />
      <FlowPane fx:id="tags" hgap="6" vgap="6" minWidth="0" prefWidth="0" />
      <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" wrapText="true" maxWidth="Infinity" />
      <Label fx:id="address" styleClass="cell_small_label" text="\$address" wrapText="true" maxWidth="Infinity" />
      <Label fx:id="email" styleClass="cell_small_label" text="\$email" wrapText="true" maxWidth="Infinity" />
    </VBox>
</HBox>
